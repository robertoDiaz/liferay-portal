Bundle-Name: Liferay Document Library Repository Dropbox Service
Bundle-SymbolicName: com.liferay.document.library.repository.dropbox.service
Bundle-Version: 1.0.0
Include-Resource: classes
Liferay-Service: true
Require-Capability:\
	liferay.extender;\
	filter:="(&(liferay.extender=spring.extender)(version>=1.0)(!(version>=2.0)))"
Spring-Context: META-INF/spring